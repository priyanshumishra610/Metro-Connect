# Copy this file to .env and fill in real values before running against a
# live backend. Expo only exposes vars prefixed EXPO_PUBLIC_ to the client —
# never put a service-role key or other secret in this file or in the app.

# Supabase project settings > API
# Must be https://<project-ref>.supabase.co (never a typo host like supase.co).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google AdMob — leave blank to fall back to Google's official test IDs
# automatically (see config/ads.ts and app.config.js). Real values only take
# effect once EXPO_PUBLIC_APP_ENV=production below — set them here ahead of
# time if you like, it's harmless while APP_ENV stays "development".
# App IDs are one per platform (not per ad placement) and require a native
# rebuild (`expo prebuild`) to take effect — see docs/ADMOB_SETUP.md.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# Ad unit IDs are per placement. Only banner is actually used in the app
# right now (Home + Discover) — interstitial/rewarded are built into
# AdManager but not yet wired to any screen, so they're optional for now.
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=

# "development" | "staging" | "production" — controls which AdMob IDs load
# and whether demo/seed data is allowed to appear. Defaults to "development".
EXPO_PUBLIC_APP_ENV=development

# Truecaller (Android sign-in) — the Client ID is not a secret, it's baked
# into the built app the same way the AdMob app ID is. Leave unset and the
# Truecaller plugin/button are both omitted entirely (see docs/TRUECALLER_SETUP.md).
# The Client SECRET is never an EXPO_PUBLIC_ var — it lives only as a Supabase
# Edge Function secret (`supabase secrets set TRUECALLER_CLIENT_SECRET=...`).
EXPO_PUBLIC_TRUECALLER_CLIENT_ID=
