# expo-router pulls in an @expo/ui -> radix-ui chain that wants React
# 19.2.8, while this project (and the rest of the Expo SDK 57 chain) is on
# 19.2.3 — a peer-dependency conflict that has needed --legacy-peer-deps on
# every `npm install` all through local development. This file makes that
# automatic everywhere, including EAS Build's cloud install step, which was
# failing during "Install dependencies" without it.
legacy-peer-deps=true
